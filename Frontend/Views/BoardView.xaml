<UserControl x:Class="Frontend.Views.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Frontend.Infrastructure.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="960" d:DesignHeight="620"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ColumnOrdinalToBrushConverter x:Key="ColumnOrdinalToBrush" />

        <!-- A- one shared card template for every task, in every column - no board/task Id is
             ever bound here (Requirement 29.c): only Title, Description, DueDate, Assignee. -->
        <DataTemplate x:Key="TaskCardTemplate">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                    Margin="0,0,0,10" Padding="10" Background="{StaticResource CardBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" Opacity="0.12" ShadowDepth="1" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44" Margin="0,0,0,6" />
                    <DatePicker SelectedDate="{Binding DueDate}" Margin="0,0,0,6" />
                    <TextBlock Text="Assignee" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" Margin="0,0,0,2" />
                    <!-- A- BUG FIX: this used to be a horizontal StackPanel with a fixed-width TextBox
                         (120px) + label + button, whose combined width exceeded the column's available
                         space and visually overflowed into the neighboring column (see screenshot).
                         A Grid with a "*" column for the TextBox and "Auto" for the button always
                         shrinks the TextBox to whatever room is left, so it can never overflow. -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding AssigneeInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                        <Button Grid.Column="1" Content="Assign" Command="{Binding AssignCommand}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save" Command="{Binding SaveCommand}" Margin="0,0,6,0" />
                        <!-- A- clearer wording + arrow for "move this task to the next column"
                             (backlog -> in progress -> done); disabled once already in "done"
                             (see TaskItemViewModel.AdvanceCommand's CanExecute). -->
                        <Button Content="Move →" Command="{Binding AdvanceCommand}"
                                Background="{StaticResource PrimaryDarkBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A- one shared column template: a colored header (accent color = which stage this is,
             via ColumnOrdinalToBrushConverter) followed by the limit editor and the task cards. -->
        <DataTemplate x:Key="ColumnTemplate">
            <!-- A- ClipToBounds is a defensive safety net: even if some future content inside a
                 card measures wider than the column, it will be clipped here instead of visually
                 bleeding into the next column (exactly the bug seen in the screenshot). -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                    Margin="8,0" Padding="0" Background="{StaticResource CardBrush}" Width="270"
                    ClipToBounds="True">
                <StackPanel>
                    <Border Background="{Binding Ordinal, Converter={StaticResource ColumnOrdinalToBrush}}"
                            CornerRadius="8,8,0,0" Padding="12,10">
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="White" />
                    </Border>
                    <StackPanel Margin="12,10,12,12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Limit" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding LimitInput, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,4,0" />
                            <Button Content="Set" Command="{Binding SetLimitCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TaskCardTemplate}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="← Back" Command="{Binding BackCommand}" Width="80" Margin="0,0,14,0" />
                <TextBlock Text="{Binding Board.Name}" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" Margin="0,8,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}" />

            <!-- A- new tasks always go to backlog (Requirement 18), so this form has no column picker. -->
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,6,0" />
                    <TextBox Text="{Binding NewTaskDescription, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding NewTaskDueDate}" Margin="0,0,6,0" />
                    <Button Content="Add Task" Command="{Binding AddTaskCommand}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <!-- A- Requirement 14: the board owner can never leave their own board - showing this
                     button to them just invited a guaranteed Backend error, so it's now hidden instead. -->
                <Button Content="Leave Board" Command="{Binding LeaveBoardCommand}"
                        Background="{StaticResource ErrorBrush}" Margin="0,0,10,0"
                        Visibility="{Binding CanLeave, Converter={StaticResource BoolToVisibility}}" />
                <!-- A- transfer-ownership controls are only meaningful for the owner - IsOwner
                     (computed from Board.OwnerEmail vs. the logged-in user) gates their visibility. -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}">
                    <TextBox Text="{Binding TransferToEmail, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,6,0" />
                    <Button Content="Transfer Ownership" Command="{Binding TransferOwnershipCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Columns}" ItemTemplate="{StaticResource ColumnTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
