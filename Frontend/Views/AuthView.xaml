<UserControl x:Class="Frontend.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Frontend.Infrastructure.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="400" d:DesignHeight="380"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
    </UserControl.Resources>

    <Border Width="340" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" Opacity="0.15" ShadowDepth="2" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Kanban" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,22" />

            <TextBlock Grid.Row="1" Text="Email" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,3" />
            <TextBox Grid.Row="2" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

            <TextBlock Grid.Row="3" Text="Password" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,3" />
            <!-- A- PasswordBox.Password cannot be bound directly (WPF blocks binding it for security);
                 PasswordChanged below is the standard, accepted way to forward it into the ViewModel. -->
            <PasswordBox x:Name="PasswordBox" Grid.Row="4" Margin="0,0,0,16"
                         PasswordChanged="PasswordBox_PasswordChanged" />

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Login" Command="{Binding LoginCommand}"
                        Width="110" HorizontalAlignment="Stretch" Margin="0,0,10,0" />
                <Button Content="Register" Command="{Binding RegisterCommand}"
                        Width="110" HorizontalAlignment="Stretch"
                        Background="{StaticResource PrimaryDarkBrush}" />
            </StackPanel>

            <TextBlock Grid.Row="6" Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       TextWrapping="Wrap" Margin="0,14,0,0" HorizontalAlignment="Center"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}" />
        </Grid>
    </Border>
</UserControl>
