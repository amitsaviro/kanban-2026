<UserControl x:Class="Frontend.Views.InProgressTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Frontend.Infrastructure.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="640" d:DesignHeight="480"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />

        <!-- A- read-only card: no Save/Move/Assign buttons, because this screen has no board
             context to call those service methods with (see InProgressTasksViewModel). -->
        <DataTemplate x:Key="ReadOnlyTaskCardTemplate">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                    Margin="0,0,0,10" Padding="12" Background="{StaticResource CardBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" Opacity="0.12" ShadowDepth="1" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11">
                        <Run Text="Due:" />
                        <Run Text="{Binding DueDate, StringFormat=d}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="← Back" Command="{Binding BackCommand}" Width="80" Margin="0,0,14,0" />
                <TextBlock Text="My In Progress Tasks" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Across all of your boards" FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}" Margin="94,2,0,0" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" Margin="0,8,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource ReadOnlyTaskCardTemplate}"
                          MaxWidth="480" HorizontalAlignment="Left" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
