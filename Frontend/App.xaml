<Application x:Class="Frontend.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Frontend">
    <!-- A- no StartupUri here: App.xaml.cs.OnStartup builds the service layer (composition root)
         and constructs MainWindow itself, so MainWindow always gets a real MainWindowViewModel
         instead of WPF creating it with a parameterless constructor before services exist. -->
    <Application.Resources>
        <ResourceDictionary>

            <!-- A- shared color palette (Requirement 28: usability) - every View below references
                 these instead of hard-coding colors, so the whole app reads as one consistent design. -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#3F6FB4" />
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#31578F" />
            <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F6F8" />
            <SolidColorBrush x:Key="CardBrush" Color="White" />
            <SolidColorBrush x:Key="BorderBrush" Color="#D8DCE2" />
            <SolidColorBrush x:Key="TextBrush" Color="#26292E" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7078" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#C0392B" />
            <SolidColorBrush x:Key="DisabledBrush" Color="#C9CDD3" />

            <!-- A- one rounded, flat Button style applied to every Button in the app automatically
                 (implicit style: no x:Key, TargetType only) - buttons stay short text/icon per
                 Requirement 28.a, this only changes how they look, not what they say. -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource DisabledBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A- flat, consistent look for every text-entry control (Requirement 28.b: readable,
                 not oversized text). Applies automatically - no per-View styling needed. -->
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="7" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="White" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Padding" Value="7" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="White" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style TargetType="DatePicker">
                <Setter Property="Padding" Value="4" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            </Style>

            <Style TargetType="ListView">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="Background" Value="White" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
